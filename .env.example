# Copy this file to .env and fill in only the providers you want to enable.
OMNI_ENVIRONMENT=development
OMNI_LOG_LEVEL=INFO
OMNI_PROVIDER_ORDER=["gemini","groq","openrouter"]
OMNI_REQUEST_TIMEOUT_SECONDS=30

# Google Gemini
OMNI_GEMINI_API_KEY=
OMNI_GEMINI_MODEL=gemini-3.8-flash

# Groq
OMNI_GROQ_API_KEY=
OMNI_GROQ_MODEL=openai/gpt-oss-20b

# OpenRouter
OMNI_OPENROUTER_API_KEY=
OMNI_OPENROUTER_MODEL=openai/gpt-4o-mini
OMNI_OPENROUTER_SITE_URL=
OMNI_OPENROUTER_APP_NAME=OmniRouter AI
