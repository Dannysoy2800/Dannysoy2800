# Personal AI OS configuration
# Copy this file to .env and fill in secrets locally. Do not commit .env.

# Required for OpenAI-powered ask/chat commands.
OPENAI_API_KEY=

# Optional model override.
OPENAI_MODEL=gpt-4.1-mini

# Local-first defaults. Docker Compose overrides workspace and database paths
# to /workspace and /data/memory.sqlite3 inside the container.
PAI_WORKSPACE=.
PAI_DB_PATH=.personal_ai_os/memory.sqlite3
PAI_LOG_LEVEL=INFO
PAI_MAX_TOOL_ROUNDS=6
PAI_SEARCH_PROVIDER=duckduckgo

# Keep model file writes disabled unless you intentionally approve and enable them.
PAI_ENABLE_MODEL_WRITES=false
